# These will be automatically created by Neon Launchpad (https://neon.new).
# You will also need to 
DATABASE_URL=

# Generate a secret key: `npx -y @better-auth/cli secret`
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# TMDB
TMDB_BEARER_TOKEN=

# OMDB
OMDB_API_KEY=

# Watchmode
WATCHMODE_API_KEY=
# Resend (password reset emails)
RESEND_API_KEY=
EMAIL_FROM=

# Sign in with Google (optional, the button is hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (optional, the button is hidden when unset)
# APPLE_CLIENT_ID is the Services ID. Generate the secret with `pnpm auth:apple-secret`.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Anthropic (AI picks and descriptive search)
ANTHROPIC_API_KEY=
